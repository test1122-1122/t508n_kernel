of: reserved_mem: reserve ranges the device tree forgot

The F50's audio DSP cannot start because `audio-mem-mgr` has no `memory-region`
property. Every other audio address is in that node - cmdaddr, smsg-addr,
shmaddr-dsp-vbc, the iram bases - so ZTE kept the whole description and removed
only the reservation, which fits a board built without a speaker.

CONFIG_OF_RESERVED_MEM_ADD (or reserved_mem_add= on the command line) is a list
of base,size pairs reserved as if the device tree had asked for them, so the
memory stays out of Linux's hands and the DSP can be loaded into it. The F50
leaves a hole for exactly this: nothing is reserved between ae8fffff (ch_ddr)
and b0000000 (logobuffer), and the two ranges another UMS9620 device uses for
audio - 0xaf700000 3 MiB and 0xafa00000 6 MiB - sit inside it, the second
ending precisely where logobuffer begins.

This is the counterpart of OF_RESERVED_MEM_SKIP, which drops nodes the device
tree does ask for.

--- a/drivers/of/Kconfig
+++ b/drivers/of/Kconfig
@@ -90,6 +90,16 @@
 	  are not reserved, so the memory stays available to Linux. Can be
 	  overridden with reserved_mem_skip= on the command line.
 
+config OF_RESERVED_MEM_ADD
+	string "Extra memory ranges to reserve"
+	depends on OF_RESERVED_MEM
+	default ""
+	help
+	  Semicolon separated base,size pairs (memparse syntax, so 0xaf700000,3M
+	  works) reserved as though /reserved-memory had listed them. For memory
+	  a device needs and that the device tree does not reserve. Can be
+	  overridden with reserved_mem_add= on the command line.
+
 config OF_RESERVED_MEM
 	bool
 	depends on OF_EARLY_FLATTREE
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -615,6 +615,45 @@
  * defined in device tree structures. It should be called by arch specific code
  * once the early allocator (i.e. memblock) has been fully activated.
  */
+static char reserved_mem_add[128] __initdata = CONFIG_OF_RESERVED_MEM_ADD;
+
+static int __init reserved_mem_add_setup(char *str)
+{
+	strlcpy(reserved_mem_add, str, sizeof(reserved_mem_add));
+	return 0;
+}
+early_param("reserved_mem_add", reserved_mem_add_setup);
+
+/* "base,size;base,size": reserve each pair as if the device tree had asked */
+static void __init reserved_mem_add_regions(void)
+{
+	char *p = reserved_mem_add;
+
+	while (*p) {
+		phys_addr_t base, size;
+		char *next;
+
+		base = memparse(p, &next);
+		if (next == p || *next != ',')
+			break;
+		p = next + 1;
+		size = memparse(p, &next);
+		if (next == p)
+			break;
+		p = next;
+		if (*p == ';')
+			p++;
+		if (!size)
+			continue;
+		if (early_init_dt_reserve_memory_arch(base, size, false))
+			pr_err("Reserved memory: failed to reserve %pa size %pa (reserved_mem_add)\n",
+			       &base, &size);
+		else
+			pr_info("Reserved memory: reserved %pa size %pa (reserved_mem_add)\n",
+				&base, &size);
+	}
+}
+
 void __init early_init_fdt_scan_reserved_mem(void)
 {
 	int n;
@@ -632,6 +671,7 @@
 	}
 
 	of_scan_flat_dt(__fdt_scan_reserved_mem, NULL);
+	reserved_mem_add_regions();
 	fdt_init_reserved_mem();
 }
 
