#!/bin/sh
# MU300: OpenWrt firmware images (armsr/armv8) are whole-disk images with their own kernel. Flashing one here would
# overwrite the eMMC partition table and bootloaders and brick the device, so flashing is refused.
# Configuration backups (-b, -l, --create-backup, --list-backup) still work through the original sysupgrade.
for a in "$@"; do
	case "$a" in
		-b|--create-backup|-l|--list-backup) exec /sbin/sysupgrade.openwrt "$@" ;;
	esac
done
echo "sysupgrade is disabled on the MU300: firmware images would overwrite the eMMC." >&2
echo "Update packages with 'apk upgrade' (not kernel/kmod-*) or reinstall with install.sh from the host." >&2
exit 1
