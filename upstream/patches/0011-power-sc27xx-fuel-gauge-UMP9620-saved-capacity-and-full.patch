 {
-	int ret, cur_clbcnt, delta_clbcnt, delta_cap, temp;
+	int ret, cur_clbcnt, delta_clbcnt, delta_cap, temp, init_clbcnt;
 
 	/* Get current coulomb counters firstly */
 	ret = sc27xx_fgu_get_clbcnt(data, &cur_clbcnt);
@@ -482,7 +561,21 @@
 	*cap = delta_cap + data->init_cap;
 
 	/* Calibrate the battery capacity in a normal range. */
+	init_clbcnt = data->init_clbcnt;
 	sc27xx_fgu_capacity_calibration(data, *cap, false);
+
+	/*
+	 * UMP9620: a calibration counts from now (the charger's Full: 100), and the user area keeps the capacity, as
+	 * Android's does, for the next boot of either system; mainline wrote it at a first power-on only, so every boot
+	 * started from the capacity Android had left.
+	 */
+	if (data->var == &ump9620_info) {
+		if (data->init_clbcnt != init_clbcnt)
+			*cap = data->init_cap;
+		*cap = clamp(*cap, 0, 100);
+		if (*cap != data->saved_cap && sc27xx_fgu_save_last_cap(data, *cap))
+			dev_err(data->dev, "failed to save battery capacity\n");
+	}
 
 	return 0;
 }
