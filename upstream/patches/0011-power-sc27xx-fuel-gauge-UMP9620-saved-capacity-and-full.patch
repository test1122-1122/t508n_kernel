+/*
+ * UMP9620: Unisoc's 5.4 driver (Android on the U30 Air) keeps the capacity in the user area as whole percent in
+ * bits 7:0 and tenths in bits 11:8: 0x23f is 63.2 %. A whole percent with no tenths is the plain number, as
+ * mainline writes it.
+ */
+#define UMP9620_FGU_CAP_INTEGER_MASK	GENMASK(7, 0)
+#define UMP9620_FGU_CAP_DECIMAL_MASK	GENMASK(11, 8)
+#define UMP9620_FGU_CAP_DECIMAL_SHIFT	8
+/* below this current (mA) the battery is at rest, and its voltage is its open-circuit voltage */
+#define UMP9620_FGU_RELAXED_MA		50
+/* the charger's Full sets 100 % only with the OCV table at this capacity or more */
+#define UMP9620_FGU_FULL_MIN_CAP	70
