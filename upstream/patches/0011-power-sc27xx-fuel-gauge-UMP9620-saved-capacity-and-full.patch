 		break;
 
 	case POWER_SUPPLY_PROP_VOLTAGE_AVG:
@@ -866,6 +960,22 @@
 		dev_err(data->dev, "failed to get init coulomb counter\n");
 }
 
+/* whether one of the chargers is there to give the status (0006 guesses it from the current otherwise) */
