  * calculate the battery open circuit voltage, and get current battery
  * capacity according to the capacity table.
  */
+/*
+ * UMP9620, not a first power-on: the capacity Android (or this driver) saved, in Android's format. The first
+ * version of patch 0011 saved it in 0.1 % (580 for 58 %), which can read as a valid value in that format too
+ * (0x244 = 68.2 %): such a value, or one that is no capacity at all, is decided by the open-circuit voltage
+ * instead, from the battery node's OCV table - right away when the battery is at rest (under 50 mA). An ambiguous
+ * value with the battery under load is taken in Android's format.
+ */
+static int ump9620_fgu_get_boot_capacity(struct sc27xx_fgu_data *data, int *cap)
+{
+	int ret, value, whole, tenths, cur = 0, ocv;
+	bool valid, ambiguous;
+
+	ret = regmap_read(data->regmap,
+			  data->base + SC27XX_FGU_USER_AREA_STATUS, &value);
+	if (ret)
+		return ret;
+
+	value &= SC27XX_FGU_CAP_AREA_MASK;
+	whole = value & UMP9620_FGU_CAP_INTEGER_MASK;
+	tenths = (value & UMP9620_FGU_CAP_DECIMAL_MASK) >> UMP9620_FGU_CAP_DECIMAL_SHIFT;
+	valid = whole <= 100 && tenths <= 9 && !(whole == 100 && tenths);
+	ambiguous = tenths && value <= 1000 && !(value % 10);
+
+	if (ambiguous) {
+		ret = sc27xx_fgu_get_current(data, &cur);
+		if (ret)
+			return ret;
+	}
+
+	if (valid && (!ambiguous || abs(cur) >= UMP9620_FGU_RELAXED_MA)) {
+		*cap = DIV_ROUND_CLOSEST(whole * 10 + tenths, 10);
+		data->saved_cap = *cap;
+		dev_info(data->dev, "boot capacity %d %% (saved 0x%03x)\n", *cap, value);
+		return sc27xx_fgu_save_boot_mode(data, SC27XX_FGU_NORMAIL_POWERTON);
+	}
+
+	ret = sc27xx_fgu_get_vbat_ocv(data, &ocv);
+	if (ret)
+		return ret;
+
+	data->boot_volt = ocv;
+	*cap = power_supply_ocv2cap_simple(data->cap_table, data->table_len, ocv);
+	dev_info(data->dev, "boot capacity %d %% from the OCV (%d uV), saved 0x%03x is %s\n", *cap, ocv, value,
+		 valid ? "ambiguous" : "no capacity");
+
+	ret = sc27xx_fgu_save_last_cap(data, *cap);
+	if (ret)
+		return ret;
+
+	return sc27xx_fgu_save_boot_mode(data, SC27XX_FGU_NORMAIL_POWERTON);
+}
+
 static int sc27xx_fgu_get_boot_capacity(struct sc27xx_fgu_data *data, int *cap)
 {
 	int volt, cur, oci, ocv, ret;
@@ -328,6 +404,9 @@
 	 * battery capacity as the initial battery capacity. Otherwise we should
