audio_mem: allow the DSP regions to be given directly

audio-mem-mgr on the F50 describes the audio DSP completely except for the one
property this driver needs: it has sprd,cmdaddr, sprd,smsg-addr,
sprd,shmaddr-dsp-vbc, both iram bases and a dozen more, and no memory-region.
ZTE kept the description and dropped the reservation, which fits a board built
without a speaker. Without those two phandles audio_mem_alloc(MEM_AUDCP_DSPBIN)
has nothing to hand sprd_audcp_boot, so the image cannot be written and the DSP
never starts.

ddr32_base/ddr32_size and dspbin_base/dspbin_size stand in for memory-region 0
and 1 when given, so the regions can come from memory reserved another way -
the kernel's reserved_mem_add= in this tree. Left at zero, the device tree is
used exactly as before, so a board that does describe them is unaffected.

--- a/sprd_audio/audiomem/audio_mem.c
+++ b/sprd_audio/audiomem/audio_mem.c
@@ -464,12 +464,57 @@
 	}
 }
 EXPORT_SYMBOL(audio_mem_unmap);
+/*
+ * This board's device tree describes the audio DSP completely except for the one property this driver needs:
+ * audio-mem-mgr has sprd,cmdaddr, sprd,smsg-addr, sprd,shmaddr-dsp-vbc, both iram bases and a dozen more, and
+ * no memory-region. ZTE kept the description and dropped the reservation, which fits a board built without a
+ * speaker.
+ *
+ * ddr32_base/size and dspbin_base/size stand in for memory-region 0 and 1 when they are given, so the regions
+ * can come from memory reserved some other way - reserved_mem_add= in this kernel. Left at zero the device
+ * tree is read exactly as before, so a board that does describe them is unaffected.
+ */
+static unsigned int ddr32_base, ddr32_size, dspbin_base, dspbin_size;
+module_param(ddr32_base, uint, 0444);
+MODULE_PARM_DESC(ddr32_base, "physical address to use instead of memory-region 0");
+module_param(ddr32_size, uint, 0444);
+MODULE_PARM_DESC(ddr32_size, "size of ddr32_base, in bytes");
+module_param(dspbin_base, uint, 0444);
+MODULE_PARM_DESC(dspbin_base, "physical address to use instead of memory-region 1");
+module_param(dspbin_size, uint, 0444);
+MODULE_PARM_DESC(dspbin_size, "size of dspbin_base, in bytes");
+
+static int audio_mem_region(struct device_node *np, int index, struct resource *res)
+{
+	struct device_node *memnp;
+	unsigned int base = index ? dspbin_base : ddr32_base;
+	unsigned int size = index ? dspbin_size : ddr32_size;
+	int ret;
+
+	if (base && size) {
+		memset(res, 0, sizeof(*res));
+		res->start = base;
+		res->end = base + size - 1;
+		res->flags = IORESOURCE_MEM;
+		pr_info("memory-region %d from module parameters: %#x size %#x\n",
+			index, base, size);
+		return 0;
+	}
+
+	memnp = of_parse_phandle(np, "memory-region", index);
+	if (!memnp)
+		return -ENODEV;
+	ret = of_address_to_resource(memnp, 0, res);
+	of_node_put(memnp);
+
+	return ret;
+}
