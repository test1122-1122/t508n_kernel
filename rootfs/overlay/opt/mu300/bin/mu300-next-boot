#!/bin/bash
# Choose what the MU300 boots next and keep Linux as default safely.
#   mu300-next-boot linux    Linux stays the default (re-armed on every successful boot)
#   mu300-next-boot android  next reboot (and later ones) go to Android
#   mu300-next-boot --rearm  used by mu300-boot-ok.service after a successful boot
#   mu300-next-boot status
# Slot b is armed with tries=2 and successful=0. LK decrements tries on boot; if Linux never reaches
# mu300-boot-ok, the next boot sees tries=1 and rolls back to slot a (Android) by itself.
# OpenWrt: od/timeout come from the static busybox in /opt/mu300/busybox-bin
export PATH="$PATH:/opt/mu300/busybox-bin"
set -eu
CONF=/etc/mu300/default-boot
BC_A=/run/mu300/misc-bc-slot-a.bin
BC_B=/run/mu300/misc-bc-slot-b-trial.bin
MISC=$(cat /run/mu300/misc-dev 2>/dev/null || readlink -f /dev/block/by-name/misc)

write_bc() {
    dd if="$1" of="$MISC" bs=1 seek=2048 conv=notrunc 2>/dev/null
    sync
    [ "$(dd if="$MISC" bs=1 skip=2048 count=32 2>/dev/null | od -An -tx1 -v | tr -d ' \n')" = "$(od -An -tx1 -v "$1" | tr -d ' \n')" ] \
        || { echo "misc verify failed" >&2; exit 1; }
}

slot_state() {
    b=$(dd if="$MISC" bs=1 skip=2048 count=32 2>/dev/null | od -An -tx1 -v | tr -d ' \n')
    echo "misc bootloader_control: $b"
    echo "  slot a info: ${b:24:2}  slot b info: ${b:28:2}  (prio<<0|tries<<4|successful<<7)"
}

case "${1:-status}" in
    linux)   mkdir -p /etc/mu300; echo linux > "$CONF"; write_bc "$BC_B"; echo "default boot: linux (slot b armed)" ;;
    android) mkdir -p /etc/mu300; echo android > "$CONF"; write_bc "$BC_A"; echo "next boot: android (slot a)" ;;
    --rearm) [ "$(cat "$CONF" 2>/dev/null)" = linux ] && write_bc "$BC_B" && echo "slot b re-armed" || echo "default boot is not linux, nothing to do" ;;
    status)  echo "default boot: $(cat "$CONF" 2>/dev/null || echo android)"; slot_state ;;
    *) echo "usage: $0 linux|android|status" >&2; exit 2 ;;
esac
