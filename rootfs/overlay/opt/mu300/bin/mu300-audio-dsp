#!/bin/sh
# Bring up the Unisoc audio DSP, which is what real call audio needs.
#
#   mu300-audio-dsp status     what is loaded, and whether the DSP wakes
#   mu300-audio-dsp load       load the 23 drivers and bind the card
#   mu300-audio-dsp start      load, write the firmware, start the DSP and open the audio routes
#   mu300-audio-dsp routes     just the routes (see set_routes below)
#   mu300-audio-dsp profiles [MODE]  load the DSP parameter blobs and select a call mode (default 7)
#   mu300-audio-dsp stop       stop the DSP (the modules stay)
#
# "start" used to reboot this device and the note here used to say so, blaming the card not being registered.
# That is no longer reproducible: on the current memory reservation the firmware has been written both with the
# card bound and with it unbound (the order Android's own module uses) and neither rebooted. The old reboot is
# unexplained rather than explained; treat "start" as safe but do not be surprised by it.
#
# The DSP does run and answers commands (see dsp_alive). What still does not work is audio actually moving:
# every scene takes exactly one buffer and then stops. docs/FINDINGS.md 24 has the measurements.
#
# The drivers come from kernel/build-audio.sh and live in /lib/modules/<release>/audio. The firmware does not
# and cannot: this project publishes no proprietary files, and unlike the Wi-Fi and modem firmware there is no
# copy on the device to take - the F50 has no audio DSP partition, because ZTE built this board without a
# speaker. Put an image at $FW (or set MU300_AGDSP_FW) and this will load it; without one the drivers still
# load and the DSP simply stays down.
#
# There is no request_firmware() involved. sprd_audcp_boot takes the image through sysfs, in chunks, between
# "stop" and "start" - see agdsp_store() in that driver.
set -u
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

A=/lib/modules/$(uname -r)/audio
BOOT=/sys/devices/platform/audiocp_boot
FW=${MU300_AGDSP_FW:-/lib/firmware/agdsp.bin}

# memory-region 0 and 1, which this board's device tree does not have. The kernel reserves these ranges through
# CONFIG_OF_RESERVED_MEM_ADD; audio_mem takes them as parameters. Index 0 is the DDR32 shared memory, index 1
# the DSP binary itself (docs/FINDINGS.md 24).
# The image is 6 MiB, which is what settles which region is which: the DSP binary goes in the larger one.
# The community Android fix names them audio-mem 0xaf700000 3 MiB and audiodsp-mem 0xafa00000 6 MiB.
DDR32=${MU300_AGDSP_DDR32:-0xaf700000,0x300000}
DSPBIN=${MU300_AGDSP_DSPBIN:-0xafa00000,0x600000}

# The order is a dependency order, not a preference: audio_sipc needs agdsp_access, the DAIs need the platform,
# the card needs all of them. Loading is attempted twice because a probe that defers once will succeed on the
# second pass once its component is there.
# virt-dma and sprd-dma first, and they are the whole reason this used to fail. CONFIG_SPRD_DMA is a module
# and nothing else pulls it in, so /sys/class/dma is empty, sprd-pcm-audio defers for want of a channel, its
# component never registers, and snd_soc_register_card gives up with "failed to init link FE_NORMAL_AP01:
# -517". Loading them brings up two controllers with sixty channels and the card follows.
DMA_MODULES="virt-dma sprd-dma"
MODULES="audio_mem agdsp_access audio_sipc sprd_audcp_boot sprd_audcp_dvfs
audio-dsp-dump audio-pipe sprd_apipe mcdt_hw_r2p0 saudio
sprd-dmaengine-pcm sprd-platform-pcm-routing sprd-compr-2stage-dma
snd-soc-sprd-dai snd-soc-sprd-vaudio snd-soc-sprd-vbc-v4 snd-soc-sprd-vbc-fe
snd-soc-sprd-codec-ump9620-power snd-soc-sprd-codec-ump9620-power-dev snd-soc-sprd-codec-ump9620
snd-soc-sprd-pa-ucp1301 snd-soc-sprd-dummy-codec snd-soc-sprd-card"

loaded() { grep -q "^$(echo "$1" | tr '-' '_') " /proc/modules; }

# Most of these are [permanent] in /proc/modules: rmmod cannot touch them, so a rebuilt driver only takes
# effect after a reboot. A reload that seems to do nothing is this, not a bad build.

load_all() {
    [ -d "$A" ] || { echo "no audio drivers in $A - run kernel/build-audio.sh and install them" >&2; return 1; }
    K=/lib/modules/$(uname -r)
    for m in $DMA_MODULES; do
        loaded "$m" && continue
        [ -f "$K/$m.ko" ] && insmod "$K/$m.ko" 2>/dev/null
    done
    n=0
    for pass in 1 2; do
        for m in $MODULES; do
            [ -f "$A/$m.ko" ] || continue
            loaded "$m" && continue
            args=
            [ "$m" = audio_mem ] && args="ddr32_base=${DDR32%,*} ddr32_size=${DDR32#*,} dspbin_base=${DSPBIN%,*} dspbin_size=${DSPBIN#*,}"
            # dai link BE_FAST_P_SMART_AMP asks for an amplifier this board does not have, and a codec that
            # defers for ever otherwise takes the whole card down with it (docs/FINDINGS.md 24)
            [ "$m" = snd-soc-sprd-card ] && args="dummy_on_defer=${MU300_AGDSP_DUMMY_ON_DEFER:-1}"
            # shellcheck disable=SC2086
            insmod "$A/$m.ko" $args 2>/dev/null && n=$((n + 1))
        done
    done
    echo "audio drivers: $(for m in $MODULES; do loaded "$m" && echo x; done | wc -l)/$(echo $MODULES | wc -w) loaded"
    bind_card
}

# The card's probe runs before the PCM platform components exist and is not retried - it returns 0 even when
# snd_soc_register_card deferred - so bind it again by hand once everything is in place.
bind_card() {
    drv=/sys/bus/platform/drivers/vbc-rxpx-codec-sc27xx
    [ -d "$drv" ] || return 0
    grep -q sprdphone /proc/asound/cards 2>/dev/null && return 0
    echo sound@0 > "$drv/unbind" 2>/dev/null
    sleep 2
    echo sound@0 > "$drv/bind" 2>/dev/null
    sleep 10
}

# status is a struct, not a string: three u32s, core_status / sys_status / sleep_status, and sys_status is
# the one that matters - 0 means "power up finished", 7 means "power off". Reading it as text says nothing,
# which is what made a working DSP look like a failed one for a while.
#
# It is still not a test of whether the firmware loaded, because the AGDSP power domain is only powered while
# something is using it. A DSP that is loaded, healthy and idle reads 7, exactly like one that never started -
# agdsp_access_enable() sends a mailbox message and waits for the power-up when a PCM is opened, and the domain
# goes back down when it closes. Use dsp_wakes below to tell the two apart.
dsp_running() {
    set -- $(od -An -tu4 -N12 "$BOOT/status" 2>/dev/null)
    [ "${2:-7}" = 0 ]
}

# The card registers with every route switched off, so opening any PCM fails with "no backend DAIs enabled for
# FE_..." and aplay reports "Unable to install hw params" - which reads like a broken driver and is not one.
# Android's HAL sets these from its own configuration; there is nothing to inherit here, so set the ones this
# board can actually use. The voice pair is the interesting one: it reaches the modem and needs no speaker,
# which this board does not have.
ROUTES=${MU300_AGDSP_ROUTES:-"S_VOICE_PCM_P SWITCH|S_VOICE_P_CODEC SWITCH|S_VOICE_C_CODEC SWITCH|S_NORMAL_AP01_P_CODEC SWITCH"}
set_routes() {
    command -v amixer >/dev/null 2>&1 || { echo "no amixer; install alsa-utils to set the routes" >&2; return 1; }
    card=$(awk '/sprdphone/ {print $1; exit}' /proc/asound/cards 2>/dev/null)
    [ -n "$card" ] || return 1
    n=0
    # shellcheck disable=SC2086
    old=$IFS; IFS='|'
    for s in $ROUTES; do
        IFS=$old
        amixer -c "$card" cset name="$s" 1 >/dev/null 2>&1 && n=$((n + 1))
        IFS='|'
    done
    IFS=$old
    echo "audio routes: $n enabled on card $card"
}

# Does the power domain come up when asked? Open a PCM for a moment and watch sys_status.
#
# This is NOT a test of the firmware, and reading it as one cost an evening: agdsp_access_enable() takes the
# AGDSP power domain up through the PMU whether or not the core has anything to execute, so this says "powered"
# and never "running". dsp_alive below is the test that distinguishes them.
dsp_wakes() {
    command -v aplay >/dev/null 2>&1 || return 2
    card=$(awk '/sprdphone/ {print $1; exit}' /proc/asound/cards 2>/dev/null)
    [ -n "$card" ] || return 2
    head -c 192000 /dev/zero | aplay -D "hw:$card,0" -f S16_LE -r 48000 -c 2 -q >/dev/null 2>&1 &
    p=$!
    sleep 1
    dsp_running; r=$?
    kill $p 2>/dev/null; wait $p 2>/dev/null
    return $r
}

# Is the core executing the image? Ask it something and see whether it answers.
#
# NOT by reading /dev/audio_dsp_log: that was tried, it returns nothing on a DSP that is demonstrably running,
# and "the log is silent so the firmware is dead" is a wrong conclusion this file used to state. This build
# simply does not log.
#
# What does settle it is aud_send_cmd's own trace. Its exit line is only reached when aud_recv_cmd returned a
# reply - a command that goes unanswered falls into "failed to get command" and never prints it (audio-sipc.c
# around line 700). So a recent "out,cmd =N ... repeat_count=1" is the DSP answering on the first try.
dsp_alive() {
    command -v aplay >/dev/null 2>&1 || return 1
    card=$(awk '/sprdphone/ {print $1; exit}' /proc/asound/cards 2>/dev/null)
    [ -n "$card" ] || return 1
    dmesg -c >/dev/null 2>&1
    # any PCM open sends the DSP a scene command; the reply is what we are looking for
    head -c 192000 /dev/zero | aplay -D "hw:$card,0" -f S16_LE -r 48000 -c 2 -q >/dev/null 2>&1
    dmesg 2>/dev/null | grep -q 'aud_send_cmd out,cmd' &&
        ! dmesg 2>/dev/null | grep -q 'failed to get command'
}

case "${1:-status}" in
load)
    load_all || exit 1
    if grep -q sprdphone /proc/asound/cards 2>/dev/null; then
        echo "cards:"; sed 's/^/  /' /proc/asound/cards
        echo "voice endpoint: $(grep -i VOICE_PCM /proc/asound/pcm 2>/dev/null | head -1)"
        echo "voice endpoint: $(grep -i VOICE_PCM /proc/asound/pcm 2>/dev/null | head -1)"
    else
        echo "the card did not register; see dmesg" >&2
    fi
    echo "the DSP itself is not started; see the warning at the top of this script"
    ;;

start)
    # load_all brings the card up first, and that order is not cosmetic: with the card unregistered the AGDSP
    # power domain is never enabled, and writing the reset registers below then reboots the device outright.
    # Measured both ways - card first, no reboot; card missing, gone in seconds.
    load_all || exit 1
    [ -d "$BOOT" ] || { echo "no $BOOT - sprd_audcp_boot did not probe" >&2; exit 1; }
    grep -q sprdphone /proc/asound/cards 2>/dev/null ||
        { echo "the sound card is not registered; starting the DSP now would reboot the device" >&2; exit 1; }
    if [ ! -f "$FW" ]; then
        echo "no DSP firmware at $FW, so the DSP stays down (drivers are loaded)" >&2
        echo "set MU300_AGDSP_FW to an AGDSP image for this SoC to start it" >&2
        exit 0
    fi
    dsp_running && { echo "the DSP is already running"; exit 0; }
    echo 1 > "$BOOT/stop" 2>/dev/null
    # one write, not a loop: the driver tracks its own offset across writes, and dd with a large block size
    # keeps the chunking to what the driver expects.
    # agdsp_store() clamps every write to ldinfo's size minus what it has taken already, so a firmware larger
    # than the reserved region is silently truncated and says nothing. $BOOT/ldinfo carries that size: on this
    # board it reads 0xafa00000 / 0x600000, which is the image exactly.
    if dd if="$FW" of="$BOOT/agdsp" bs=4096 2>/dev/null; then
        echo 1 > "$BOOT/start" 2>/dev/null
        set_routes
        # Not "dsp_running" - see dsp_wakes. An idle AGDSP reads powered off whether or not it ever loaded.
        dsp_wakes; w=$?
        case $w in
            0) echo "wrote $FW ($(wc -c < "$FW") bytes); the power domain comes up on demand"
               dsp_alive && echo "and the DSP is running" || echo "but the core is not executing it - see status" ;;
            2) echo "DSP started from $FW ($(wc -c < "$FW") bytes); install alsa-utils to confirm it wakes" ;;
            *) echo "wrote $FW but the DSP did not wake when a PCM was opened; see dmesg" >&2; exit 1 ;;
        esac
        # The card is only built once the DSP answers, and the machine driver has already given up by now -
        # its probe returned before the firmware existed. Bind it again by hand.
        drv=/sys/bus/platform/drivers/vbc-rxpx-codec-sc27xx
        if [ -d "$drv" ] && [ ! -e "$drv/sound@0" ]; then
            echo sound@0 > "$drv/bind" 2>/dev/null
            sleep 2
        fi
        echo "cards:"; sed 's/^/  /' /proc/asound/cards
        echo "voice endpoint: $(grep -i VOICE_PCM /proc/asound/pcm 2>/dev/null | head -1)"
    else
        echo "could not write $FW to $BOOT/agdsp" >&2; exit 1
    fi
    ;;

stop)
    [ -d "$BOOT" ] || { echo "no $BOOT"; exit 0; }
    echo 1 > "$BOOT/stop" 2>/dev/null && echo "DSP stopped"
    ;;

status)
    echo "drivers:  $(for m in $MODULES; do loaded "$m" && echo x; done | wc -l)/$(echo $MODULES | wc -w) loaded"
    echo "firmware: $([ -f "$FW" ] && echo "$FW ($(wc -c < "$FW") bytes)" || echo "not present at $FW")"
    if [ -d "$BOOT" ]; then
        set -- $(od -An -tu4 -N12 "$BOOT/status" 2>/dev/null)
        echo "power:    core=${1:-?} sys=${2:-?} sleep=${3:-?} (sys 0 is powered, 7 is off - and off is normal when idle)"
        # ldinfo is a struct too: char name[32], u32 load_phy_addr, u32 size. Printed as text it is the name
        # and then noise, and the two numbers are the ones worth seeing - the size is what agdsp_store clamps
        # every firmware write to.
        set -- $(od -An -tu4 -j32 -N8 "$BOOT/ldinfo" 2>/dev/null)
        [ -n "${1:-}" ] && printf 'ldinfo:   %s loads at %#x, room for %s bytes\n' \
            "$(head -c 32 "$BOOT/ldinfo" 2>/dev/null | tr -d '\0')" "$1" "$2"
        case "$(dsp_wakes; echo $?)" in
            0) echo "power-up: yes - the domain came up when a PCM was opened" ;;
            2) echo "power-up: unknown - install alsa-utils to open a PCM and find out" ;;
            *) echo "power-up: no; run 'start' (needs the firmware at $FW)" ;;
        esac
        if dsp_alive; then
            echo "dsp:      running - it answered a command on the first try"
            echo "          (a PCM can still fail with EIO: the data path also needs the DSP profiles,"
            echo "           /lib/firmware/{audio_structure,dsp_vbc,cvs} - docs/FINDINGS.md 24)"
        else
            echo "dsp:      no reply - run 'start' (needs the firmware at $FW), then look for"
            echo "          'aud_send_cmd out,cmd' against 'failed to get command' in dmesg"
        fi
    else
        echo "dsp:      sprd_audcp_boot has not probed"
    fi
    echo "cards:"; sed 's/^/  /' /proc/asound/cards 2>/dev/null
    ;;

routes)
    set_routes
    ;;

profiles)
    # Load the four DSP parameter blobs and apply one mode. Build them with tools/vbc-profile from a vendor
    # parameter XML set; the kernel picks them up from /lib/firmware by these exact names.
    #
    # The mode number is a call scene, not a media one - audio_structure.xml's modes are Handset, Handsfree,
    # Headset4P/3P, BTHS, TypeC, HighVolume and Hac, each with NB1/NB2/WB1/WB2/SWB1/FB1/VOIP1, plus four
    # Loopback modes. There is no "media playback" mode, so these profiles are about a call.
    #   0 Handset/NB1   7 Handsfree/NB1   9 Handsfree/WB1   28 BTHS/NB1   63 Loopback/Handset
    #
    # param_id 0x5e is not decoration. The select value is (mode << 24) | (param_id << 16) | dsp_case, and
    # with param_id 0 the apply is a no-op; with 0x5e - which is what a working device of this family has in
    # both selects - the driver actually copies the mode into the DSP's shared memory:
    #   [Audio:SIPC] cmd =11 sharemem_info.id=…, phy_iram_addr=0xaf981210, size=0x6c4
    # and 0xaf981210 is sprd,shmaddr-dsp-vbc from the device tree.
    command -v amixer >/dev/null 2>&1 || { echo "no amixer; install alsa-utils" >&2; exit 1; }
    card=$(awk '/sprdphone/ {print $1; exit}' /proc/asound/cards 2>/dev/null)
    [ -n "$card" ] || { echo "the sound card is not registered" >&2; exit 1; }
    mode=${2:-${MU300_AGDSP_MODE:-7}}
    sel=$(( (mode << 24) | (0x5e << 16) ))
    n=0
    for p in audio_structure dsp_vbc cvs dsp_smartamp; do
        [ -f "/lib/firmware/$p" ] || { echo "missing /lib/firmware/$p (see tools/vbc-profile)" >&2; continue; }
        case $p in
            audio_structure) u='Audio Structure Profile Update' ;;
            dsp_vbc)         u='DSP VBC Profile Update' ;;
            cvs)             u='CVS Profile Update' ;;
            dsp_smartamp)    u='DSP SMARTAMP Update' ;;
        esac
        amixer -c "$card" cset name="$u" 1 >/dev/null 2>&1 && n=$((n + 1))
    done
    for s in 'Audio Structure Profile Select' 'DSP VBC Profile Select'; do
        amixer -c "$card" cset name="$s" "$sel" >/dev/null 2>&1
    done
    echo "profiles: $n loaded, mode $mode selected (value $sel)"
    ;;

*)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 2 ;;
esac
