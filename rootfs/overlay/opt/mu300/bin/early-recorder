#!/bin/sh
# Early boot recorder: for the first minutes after switch_root, copy dmesg + unit states into the persistent
# log area inside boot_b (48 MiB, 8 MiB) every few seconds, so a power cut before journald flushes still
# leaves evidence that tools/collect-logs.sh can read from Android.
# OpenWrt: od/timeout come from the static busybox in /opt/mu300/busybox-bin
export PATH="$PATH:/opt/mu300/busybox-bin"
BOOTB=$(readlink -f /dev/block/by-name/boot_b 2>/dev/null)
[ -b "$BOOTB" ] || for u in /sys/class/block/mmcblk0p*/uevent; do grep -qx PARTNAME=boot_b "$u" && BOOTB=/dev/$(basename "$(dirname "$u")"); done
[ -b "$BOOTB" ] || exit 0
end=$(( $(cut -d. -f1 /proc/uptime) + ${1:-300} ))
while [ "$(cut -d. -f1 /proc/uptime)" -lt "$end" ]; do
    {
        echo "MU300-PERSIST-BEGIN uptime=$(cut -d' ' -f1 /proc/uptime) (early-recorder)"
        cat /run/stages 2>/dev/null
        ip -br addr 2>/dev/null
        echo "--- lsmod"
        systemctl list-units --no-legend --plain --state=activating,failed 2>/dev/null
        [ -f /etc/openwrt_release ] && { echo "--- ps"; ps w 2>/dev/null; echo "--- logread"; logread 2>/dev/null | grep -v PR_CAPBSET | tail -300; echo "--- android logcat"; tail -150 /var/log/android-logcat.txt 2>/dev/null; echo "--- mu300 logs"; tail -40 /tmp/mu300-*.log 2>/dev/null; }
        echo "--- dmesg"
        dmesg | tail -c 3000000
        echo "MU300-PERSIST-END"
    } > /run/mu300-early.txt 2>&1
    head -c 65536 /dev/zero >> /run/mu300-early.txt
    dd if=/run/mu300-early.txt of="$BOOTB" bs=4096 seek=12288 count=2048 conv=notrunc 2>/dev/null
    sync
    sleep 5
done
